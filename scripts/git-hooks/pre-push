#!/bin/sh
# Pre-push hook — mirrors the CI checks so fmt/clippy failures are caught locally.
# Install with: make install-hooks
set -e

echo "▶ cargo fmt --check"
cargo fmt --all -- --check

# proteus-shell-web / proteus-host-web are wasm32-only (wgpu::SurfaceTarget::
# Canvas usage is #[cfg(web)]-gated, i.e. target_arch = "wasm32") — neither
# can ever compile for the host target, so both are excluded from the
# host-target clippy pass and checked separately against their real target
# instead. Mirrors ci.yml.
echo "▶ cargo clippy (host, workspace minus proteus-shell-web/proteus-host-web)"
cargo clippy --workspace --exclude proteus-shell-web --exclude proteus-host-web --all-targets --all-features -- -D warnings

echo "▶ cargo clippy (proteus-shell-web + proteus-host-web, wasm32-unknown-unknown)"
cargo clippy -p proteus-shell-web -p proteus-host-web --target wasm32-unknown-unknown --all-targets --all-features -- -D warnings

echo "✓ pre-push checks passed"
