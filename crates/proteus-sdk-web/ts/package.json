{
  "name": "proteus-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Proteus, a UI framework whose components transform into other components instead of loading new screens. Draws with WebGPU or WebGL2.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": "Blue <isaac.chellin@gmail.com>",
  "homepage": "https://github.com/ichellin1/proteus/tree/main/docs",
  "bugs": {
    "url": "https://github.com/ichellin1/proteus/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ichellin1/proteus",
    "directory": "crates/proteus-sdk-web/ts"
  },
  "keywords": [
    "proteus",
    "ui",
    "ui-framework",
    "webgl",
    "webgl2",
    "webgpu",
    "wasm",
    "webassembly",
    "animation",
    "transitions",
    "metamorphic"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "pkg",
    "pkg-host"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "rm -f pkg/.gitignore pkg-host/.gitignore",
    "check-docs": "typedoc src/index.ts --emit none --excludeInternal --validation.notDocumented --validation.invalidLink --treatValidationWarningsAsErrors",
    "check-snippets": "node ../../../scripts/check-ts-snippets.mjs"
  },
  "devDependencies": {
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0"
  }
}
