{
  "name": "proteus-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Proteus, a metamorphic-component UI framework rendered GPU-native via WebGL2/WebGPU — components transform continuously into other components instead of loading new screens.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ichellin1/proteus",
    "directory": "crates/proteus-sdk-web/ts"
  },
  "keywords": [
    "proteus",
    "ui",
    "ui-framework",
    "webgl",
    "webgl2",
    "webgpu",
    "wasm",
    "webassembly",
    "animation",
    "transitions",
    "metamorphic"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "pkg",
    "pkg-host"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "rm -f pkg/.gitignore pkg-host/.gitignore"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
